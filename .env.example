# Copy to .env. Generate independent secrets; never commit .env. Set AGENTLAB_ENV=production in production.
POSTGRES_PASSWORD=replace-with-long-random-postgres-password
# Set from git rev-parse HEAD before deploying, or leave unknown (explicitly unpinned).
GIT_COMMIT=unknown
# Ports bind to loopback by default; use a TLS reverse proxy for remote access.
AGENTLAB_BIND_ADDRESS=127.0.0.1
AGENTLAB_ENV=development
# For host-only runs, replace password to match POSTGRES_PASSWORD. Compose overrides this URL.
AGENTLAB_DATABASE_URL=postgresql+psycopg://agentlab:replace-with-long-random-postgres-password@localhost:5432/agentlab
AGENTLAB_REDIS_URL=redis://localhost:6379/0
AGENTLAB_QUEUE_MODE=celery
AGENTLAB_AUTH_MODE=required
AGENTLAB_API_KEY=replace-with-a-long-random-secret
# Optional read-only key for viewers (different from admin key)
# AGENTLAB_READONLY_API_KEY=
# Server-only Next.js secret (must equal AGENTLAB_API_KEY, NEVER prefix with NEXT_PUBLIC_)
API_INTERNAL_URL=http://localhost:8000
BACKEND_API_KEY=replace-with-a-long-random-secret
# Web console login (both at least 32 random characters, do NOT use NEXT_PUBLIC_ variables)
WEB_AUTH_MODE=required
WEB_ACCESS_KEY=replace-with-separate-random-web-access-key
WEB_SESSION_SECRET=replace-with-random-hmac-signing-secret
# Optional model credentials. Only their *environment-variable names* appear in saved versions.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=
# AGENTLAB_OPENAI_BASE_URL=https://api.openai.com/v1
# AGENTLAB_OLLAMA_BASE_URL=http://host.docker.internal:11434
# AGENTLAB_CUSTOM_HTTP_URL=https://your-allowlisted-agent.example/run
AGENTLAB_DEMO_SEED=true

# Optional operational controls (Compose wires these explicitly to the correct service).
# AGENTLAB_MAX_REQUEST_BYTES=1048576
# AGENTLAB_RATE_LIMIT_PER_MINUTE=180
# AGENTLAB_TRACE_CAPTURE=redacted
# AGENTLAB_PROVIDER_TIMEOUT_SECONDS=45
# AGENTLAB_ENABLE_LLM_JUDGE=false
# AGENTLAB_JUDGE_MODEL=
# AGENTLAB_JUDGE_API_KEY=
# AGENTLAB_JUDGE_BASE_URL=https://api.openai.com/v1
