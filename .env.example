# Copy to .env for local development. In production set AGENTLAB_ENV=production and both keys.
AGENTLAB_ENV=development
AGENTLAB_DATABASE_URL=postgresql+psycopg://agentlab:agentlab@localhost:5432/agentlab
AGENTLAB_REDIS_URL=redis://localhost:6379/0
AGENTLAB_QUEUE_MODE=celery
AGENTLAB_AUTH_MODE=required
AGENTLAB_API_KEY=replace-with-a-long-random-secret
# Optional read-only key for viewers (different from admin key)
# AGENTLAB_READONLY_API_KEY=
# Server-only Next.js secret (must equal AGENTLAB_API_KEY, NEVER prefix with NEXT_PUBLIC_)
API_INTERNAL_URL=http://localhost:8000
BACKEND_API_KEY=replace-with-a-long-random-secret
# Optional model credentials. Only their *environment-variable names* appear in saved versions.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=
# AGENTLAB_OPENAI_BASE_URL=https://api.openai.com/v1
# AGENTLAB_OLLAMA_BASE_URL=http://host.docker.internal:11434
# AGENTLAB_CUSTOM_HTTP_URL=https://your-allowlisted-agent.example/run
AGENTLAB_DEMO_SEED=true
